local GuiLib = require "guilib.guilib"

local log_text_list = {}
local log_counter = 0
local log_previous_text = nil
local function log(text)
  if log_previous_text == text then
    log_counter = log_counter + 1
    log_text_list[1] = string.format("%s (%d)", text, log_counter)
  else
    log_counter = 1
    log_previous_text = text
    table.insert(log_text_list, 1, text)
    if #log_text_list>10 then
      log_text_list[#log_text_list] = nil
    end
  end
  gui.set_text(gui.get_node("logtext"), table.concat(log_text_list, "\n"))
end

function init(self)
  local version = gui.get_node('version')
  gui.set_text(version, string.format(gui.get_text(version), sys.get_config_string("project.version")))
  msg.post(".", "acquire_input_focus")
  self.guilib = GuiLib()
  --- touch
  self.guilib.on("box_touch", hash("touch"), function(e) log(string.format("touch pressed=%s released=%s", e.pressed, e.released)) end)
  --- pressed
  self.guilib.on("box_pressed", "pressed", function() log("pressed") end)
  --- hold
  self.guilib.on("box_hold", "hold", function() log("hold") end)
  --- hold
  self.guilib.on("box_release", "released", function() log("released") end)
  --- hover
  self.guilib.on("box_hover", "hover", function() log("Hover") end)
  --- enter/leave
  self.guilib.on("box_enter_leave", "enter", function(e) gui.play_flipbook(e.node, "button2") log("Enter") end)
  self.guilib.on("box_enter_leave", "leave", function(e) gui.play_flipbook(e.node, "button0") log("Leave") end)
  --- click_outside
  self.guilib.on("box_click_outside", "click_outside", function(e) log("click_outside") end)
  --- mouse wheel up/down
  self.guilib.on("box_mouse_wheel", hash('mouse_wheel_up'), function(e) pprint(e) log("mouse wheel up") end)
  self.guilib.on("box_mouse_wheel", hash('mouse_wheel_down'), function() log("mouse wheel down") end)
  --- key space
  self.guilib.on("box_key_space", hash('key_space'), function() log("key_space") end)

  self.guilib.dump()
end

function on_input(self, action_id, action)
  pprint(action_id, self.guilib.on_input(action_id, action))
end
