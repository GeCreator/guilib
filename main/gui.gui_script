local guilib = require "guilib.guilib"
local dropdown_component = require "components.dropdown.dropdown"


local examples = {
  ["Pressed/Hold/Released"] = require("examples.pressed_hold_released.pressed_hold_released"),
  Hover = require("examples.hover.hover"),
  Drag = require("examples.drag.drag"),
  Wheel = require("examples.wheel.wheel"),
  ["Enter/Leave"] = require("examples.enter_leave.enter_leave"),
  Focus = require("examples.focus.focus"),
  ["Click Outside"] = require("examples.click_outside.click_outside")
}

local log_text_list = {}
local log_counter = 0
local current_example = nil

local function log(text)
  log_counter = log_counter + 1
  table.insert(log_text_list, 1, tostring(log_counter).. ". " .. text)
  if #log_text_list>30 then
    log_text_list[#log_text_list] = nil
  end
  gui.set_text(gui.get_node("logtext"), table.concat(log_text_list, "\n"))
end

local function log_clear()
  gui.set_text(gui.get_node("logtext"), "")
  log_text_list = {}
end


function init(self)
  msg.post(".", "acquire_input_focus")
  self.guilib = guilib()
  self.guilib_showcase = self.guilib.create_subprocess()
  local dropdown = dropdown_component(self.guilib, "dropdown")

  dropdown.add("Pressed/Hold/Released")
  dropdown.add("Hover")
  dropdown.add("Drag")
  dropdown.add("Wheel")
  dropdown.add("Enter/Leave")
  dropdown.add("Focus")
  dropdown.add("Click Outside")

  dropdown.on_select(function(selection)
    if current_example then gui.set_enabled(current_example, false) end
    current_example = gui.get_node(selection .. '/root')
    gui.set_enabled(current_example, true)
    self.guilib_showcase.clear()
    self.guilib_showcase.set_namespace(selection)
    examples[selection](self.guilib_showcase, log)
    log_clear()
  end)

  dropdown.set_selected("Drag")
end

function on_input(self, action_id, action)
  self.guilib.on_input(action_id, action)
end
